# Shared service configuration
REDIS_URL=redis://redis:6379/0

# Local Postgres defaults (used by the optional postgres service profile)
POSTGRES_DB=bali_events
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application database connection string
DATABASE_URL=postgres://postgres:postgres@postgres:5432/bali_events

# Bot API exposed port
BOT_API_PORT=8080
